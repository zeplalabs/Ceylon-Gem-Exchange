# Local dev only — copy to .env. Not used for staging/prod (those use real
# managed services and Secrets Manager, per the Phase 0 sequencing decision).

# Local Docker Postgres — only used when DATABASE_URL below is unset.
POSTGRES_USER=ceylon_gems
POSTGRES_PASSWORD=ceylon_gems_dev
POSTGRES_DB=ceylon_gems
# 55432, not 5432 — avoids colliding with a native/system Postgres install
POSTGRES_PORT=55432

# Shared dev Postgres (Supabase project "ceylon-gem-exchange", ap-south-1) —
# takes priority over the POSTGRES_* vars above when set. Ask a teammate (or
# check the Supabase dashboard, Settings → Database → Connection string →
# Session pooler) for the real value — it's a shared credential, not
# something to generate yourself. Must be the *session*-mode pooler
# (aws-0-ap-south-1.pooler.supabase.com:5432), not the transaction-mode
# pooler (port 6543, for serverless callers) and not the direct
# db.<ref>.supabase.co host (IPv6-only on the free tier, won't resolve on
# most networks). Leave blank to use the local Docker Postgres instead.
DATABASE_URL=

REDIS_PORT=6379

TYPESENSE_API_KEY=ceylon_gems_dev_key
TYPESENSE_PORT=8108

MINIO_ROOT_USER=ceylon_gems
MINIO_ROOT_PASSWORD=ceylon_gems_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Clerk (Development instance, from dashboard.clerk.com → API Keys) —
# apps/api only, never exposed to clients
CLERK_SECRET_KEY=
# From the webhook endpoint you create in the Clerk dashboard (Svix signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=
