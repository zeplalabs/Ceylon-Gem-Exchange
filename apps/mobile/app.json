{
  "expo": {
    "name": "Ceylon Gem Exchange",
    "slug": "ceylon-gems",
    "scheme": "ceylongems",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeplalabs.ceylongems"
    },
    "android": {
      "package": "com.zeplalabs.ceylongems"
    },
    "plugins": [
      "./plugins/withAndroidLargeHeap.js",
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      "expo-localization",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/jost/400Regular/Jost_400Regular.ttf",
            "node_modules/@expo-google-fonts/jost/500Medium/Jost_500Medium.ttf",
            "node_modules/@expo-google-fonts/jost/600SemiBold/Jost_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/jost/700Bold/Jost_700Bold.ttf",
            "node_modules/@expo-google-fonts/jost/800ExtraBold/Jost_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-sinhala/400Regular/NotoSansSinhala_400Regular.ttf",
            "node_modules/@expo-google-fonts/noto-sans-sinhala/500Medium/NotoSansSinhala_500Medium.ttf",
            "node_modules/@expo-google-fonts/noto-sans-sinhala/600SemiBold/NotoSansSinhala_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-sinhala/700Bold/NotoSansSinhala_700Bold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-sinhala/800ExtraBold/NotoSansSinhala_800ExtraBold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-tamil/400Regular/NotoSansTamil_400Regular.ttf",
            "node_modules/@expo-google-fonts/noto-sans-tamil/500Medium/NotoSansTamil_500Medium.ttf",
            "node_modules/@expo-google-fonts/noto-sans-tamil/600SemiBold/NotoSansTamil_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-tamil/700Bold/NotoSansTamil_700Bold.ttf",
            "node_modules/@expo-google-fonts/noto-sans-tamil/800ExtraBold/NotoSansTamil_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-video",
      "expo-asset",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ceylon Gem Exchange uses your photo library to set your profile photo.",
          "cameraPermission": "Ceylon Gem Exchange uses your camera to take a profile photo."
        }
      ]
    ]
  }
}
