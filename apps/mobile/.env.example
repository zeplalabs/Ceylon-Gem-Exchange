# Local dev only — copy to .env. From the Clerk dashboard → API Keys
# (Development instance). Publishable key is safe to expose client-side.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Leave this as localhost for both the iOS simulator and the Android
# emulator — lib/apiUrl.ts rewrites it to 10.0.2.2 on Android automatically,
# since the Android emulator can't resolve "localhost" as the host machine.
# A physical device (either platform) needs the host's real LAN IP or a
# tunnel instead — set that here directly and it passes through unchanged.
EXPO_PUBLIC_API_URL=http://localhost:3000
